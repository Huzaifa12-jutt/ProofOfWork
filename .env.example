# ===================================================
# ProofOfWork - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR LOCAL VALUES
# NEVER COMMIT THE ACTUAL .env FILE TO GIT
# ===================================================

# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proofofwork_dev?schema=public"

# Authentication (Argon2id + JWT)
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Redis (for BullMQ background jobs - Phase 6)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Object Storage (Cloudflare R2 or AWS S3 - for file submissions)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME="proofofwork-dev"

# AI Service (FastAPI / LLM - Phase 7 / Week 10)
AI_SERVICE_URL="http://localhost:8000"
LLM_API_KEY=""
